{
    "name": "foursquare-server",
    "version": "0.1.0",
    "description": "Backend server for Foursquare game",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "prisma:generate": "prisma generate",
        "db:migrate:deploy": "prisma migrate deploy",
        "build": "npm run prisma:generate && tsc",
        "test": "npm run build && node --test dist/game/rules.test.js dist/game/room_manager.test.js dist/gateway/socket.test.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^5.2.1",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.14",
        "@types/express": "^5.0.6",
        "@types/node": "^20.8.2",
        "prisma": "^6.19.3",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.2.2"
    }
}
